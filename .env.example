# =============================================================================
# Competitive Insights UI — Environment Configuration
# =============================================================================

# --- Orchestrator API ---
# URL of the CompetitorEngine orchestrator (FastAPI service)
# VITE_API_URL=http://localhost:8001

# --- GitHub Data Source ---
# Predefined examples load from this repository's data/ directory by default.
# Set this to use another GitHub repository. Format: "owner/repo".
# VITE_DATA_REPO=myorg/competitor-data

# Branch to fetch data from (default: main)
# VITE_DATA_BRANCH=main
